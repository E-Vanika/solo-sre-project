# Copy to .env on the VM, fill in real values, never commit .env
GHCR_OWNER=your-github-username
IMAGE_TAG=latest

# Grafana Cloud (or VictoriaMetrics Cloud) free tier remote_write creds
REMOTE_WRITE_URL=https://prometheus-prod-XX-xxx.grafana.net/api/prom/push
REMOTE_WRITE_USER=your-instance-id
REMOTE_WRITE_PASSWORD=your-api-key
